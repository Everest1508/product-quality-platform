[Logs]
sudo docker compose logs --tail 200 web

[Follow Logs]
sudo docker compose logs -f --tail 50 web

[Backup Database]
sudo mkdir -p backups
sudo cp db.sqlite3 backups/db-$(date +%F-%H%M).sqlite3
ls -lh backups

[Migrate]
sudo docker compose exec web python manage.py migrate --noinput

[Dry Run Fix DSR Hours]
sudo docker compose exec web python manage.py fix_dsr_hours --dry-run

[Fix DSR Hours]
sudo docker compose exec web python manage.py fix_dsr_hours

[Dry Run Reminders]
sudo docker compose exec web python manage.py send_attendance_reminders --dry-run

[Send Attendance Reminders]
sudo docker compose exec web python manage.py send_attendance_reminders

[Dry Run Automation Rules]
sudo docker compose exec web python manage.py evaluate_rules --dry-run

[Run Automation Rules]
sudo docker compose exec web python manage.py evaluate_rules

[Notify Overdue Todos]
sudo docker compose exec web python manage.py notify_todos

[Django Check]
sudo docker compose exec web python manage.py check

[Shell]
sudo docker compose exec web python manage.py shell
