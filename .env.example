# --- CardSnap app auth (apps.appauth) ---
# Signs 15-minute access tokens (HS256). Required when DJANGO_DEBUG is off. Share it with the Marketing API.
JWT_SECRET=
# Google OAuth client IDs accepted as the ID token's `aud` (see API.md for the console steps)
GOOGLE_WEB_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
# Optional deep link the password-reset email appends ?token=... to
APPAUTH_RESET_URL=cardsnap://reset-password
# Outgoing mail via Mailflare (an admin can instead enter the key in the CRM under Email settings; the UI wins)
MAILFLARE_API_URL=https://mailflare.riteshmahale15.workers.dev/api/v1/send
MAILFLARE_API_KEY=
MAILFLARE_MAILBOX_ID=
# The one mailbox address Mailflare allows; DEFAULT_FROM_EMAIL must be this address
MAILFLARE_FROM_ADDRESS=no-reply@example.com
DEFAULT_FROM_EMAIL=CardSnap <no-reply@example.com>

# --- existing settings ---
DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=crm.example.com
SHARED_SERVER_ENCRYPTION_KEY=
DJANGO_BEHIND_HTTPS_PROXY=1
REDIS_URL=

# Sign in with Apple: iOS bundle ID (identity token audience)
APPLE_CLIENT_ID=
